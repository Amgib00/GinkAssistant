# Copy to .env and fill in. .env is in .gitignore -- never commit it.
# Used by the built-in server when you run Gink on your computer.
GROQ_API_KEY=
GEMINI_API_KEY=
GINK_SECRET_KEY=
# Optional
# GINK_API_URL=https://your-server.example.com
# GINK_TTS_MODEL=gemini-3.8-flash-lite-tts
# PICOVOICE_ACCESS_KEY=
# GINK_WAKEWORD_FILE=

# Phone sign-in (SMS) -- one provider. Each SMS costs money; the monthly limit pauses phone codes when reached.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
GINK_SMS_PROVIDER=          # africastalking or twilio, only if both are filled in
GINK_SMS_MONTHLY_LIMIT=500
